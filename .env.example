# ==========================================
# CONFIGURAÇÃO DE NUVEM OPCIONAL (SUPABASE)
# ==========================================
# Se preenchidas, o site sincroniza os produtos e pedidos globalmente com o Supabase.
# Se vazias ou ausentes, o site opera normalmente em modo local e fallback de fábrica.
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SEU_ANON_KEY_AQUI

# ==========================================
# MERCADO PAGO - INTEGRAÇÃO PIX EM TEMPO REAL
# ==========================================
# Token de Acesso (Production ou Sandbox) do Mercado Pago.
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=APP_USR-SEU_TOKEN_MERCADO_PAGO_AQUI
