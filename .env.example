# ==========================================
# CONFIGURAÇÃO DE NUVEM OPCIONAL (SUPABASE)
# ==========================================
# Se preenchidas, o site sincroniza os produtos globalmente com o Supabase.
# Se vazias ou ausentes, o site opera 100% normalmente em modo local e fallback de fábrica.
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SEU_ANON_KEY_AQUI
