/*
  cache-control: public, max-age=0, must-revalidate, s-maxage=60, stale-while-revalidate=86400

/assets/*
  cache-control: public, max-age=31536000, immutable

/favicon.png
  cache-control: public, max-age=86400, stale-while-revalidate=604800

/robots.txt
  cache-control: public, max-age=86400, stale-while-revalidate=604800
